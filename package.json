{
  "name": "bytriska.my.id",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "simple-git-hooks",
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build",
    "preview": "vite preview",
    "lint": "eslint --cache . && prettier --cache --check .",
    "lint:fix": "eslint --cache --fix . && prettier --cache --write ."
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@iconify/json": "^2.2.472",
    "@mdit-vue/plugin-headers": "^3.0.2",
    "@mdit/plugin-alert": "^0.23.2",
    "@mdit/plugin-attrs": "^0.25.2",
    "@mdit/plugin-container": "^0.23.2",
    "@shikijs/transformers": "^4.0.2",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^24.12.4",
    "@unhead/vue": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.3.0",
    "gray-matter": "^4.0.3",
    "lint-staged": "^16.4.0",
    "markdown-exit": "1.0.0-beta.9",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-emoji": "^3.0.0",
    "prettier": "^3.8.3",
    "shiki": "^4.0.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.1.0",
    "unplugin-vue-markdown": "^30.0.0",
    "vite": "^7.3.3",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.2.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,json,yaml,md,css,vue,svg}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ]
  }
}
