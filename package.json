{
  "name": "bytriska.my.id",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "postinstall": "simple-git-hooks && pnpm types:generate",
    "dev": "vite",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "depoy": "pnpm build && wrangler deploy",
    "lint": "eslint --cache . && prettier --cache --check .",
    "lint:fix": "eslint --cache --fix . && prettier --cache --write .",
    "types:generate": "wrangler types ./src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@cloudflare/vite-plugin": "^1.54.7",
    "@iconify/json": "^2.2.527",
    "@mdit-vue/plugin-headers": "^3.0.2",
    "@mdit/plugin-alert": "^2.0.1",
    "@mdit/plugin-attrs": "^1.3.1",
    "@mdit/plugin-container": "^2.0.1",
    "@shikijs/transformers": "^4.4.3",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^24.13.4",
    "@unhead/vue": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "gray-matter": "^4.0.3",
    "lint-staged": "^17.5.1",
    "markdown-exit": "1.3.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "^3.1.0",
    "prettier": "^3.9.6",
    "shiki": "^4.4.3",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.13.7",
    "typescript": "~6.0.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.131.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,json,yaml,md,css,vue}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ]
  }
}
