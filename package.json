{
  "name": "bytriska.my.id",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "postinstall": "simple-git-hooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "depoy": "pnpm build && wrangler deploy",
    "lint": "eslint --cache . && prettier --cache --check .",
    "lint:fix": "eslint --cache --fix . && prettier --cache --write ."
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@cloudflare/vite-plugin": "^1.54.1",
    "@iconify/json": "^2.2.521",
    "@mdit-vue/plugin-headers": "^3.0.2",
    "@mdit/plugin-alert": "^0.23.2",
    "@mdit/plugin-attrs": "^0.25.2",
    "@mdit/plugin-container": "^0.23.2",
    "@shikijs/transformers": "^4.4.3",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "^24.13.3",
    "@unhead/vue": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.9.1",
    "gray-matter": "^4.0.3",
    "lint-staged": "^16.4.0",
    "markdown-exit": "1.0.0-beta.9",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-emoji": "^3.1.0",
    "prettier": "^3.9.6",
    "shiki": "^4.4.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.1.0",
    "unplugin-vue-markdown": "^30.0.0",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,json,yaml,md,css,vue}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ]
  }
}
